# ── Copy to backend/.env for local dev, or set these as Railway variables ────

ENV=production

# Supabase → Project Settings → Database → Connection string → URI (Session pooler)
# Remember to URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Postgres schema that owns every EduOS table.
# IMPORTANT: this Supabase project is shared with LearnSpace. Both apps would
# otherwise create tables called `users`, `schools`, ... in `public` and clash.
# Keeping EduOS in its own schema makes the two completely independent.
DB_SCHEMA=eduos

# Sign JWTs. MUST be changed in production — anyone with this value can mint
# tokens for any account.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── First super admin ────────────────────────────────────────────────────────
# Created automatically on startup if no super admin exists. The password is
# only applied at creation — later password changes are never overwritten.
SUPER_ADMIN_EMAIL=superadmin@nyxion.ai
SUPER_ADMIN_PASSWORD=change-this-before-first-boot
SUPER_ADMIN_NAME=Nyxion Super Admin
SUPER_ADMIN_FORCE_PASSWORD_CHANGE=true

# Seed the demo schools (The City School / Beacon House) with sample
# teachers, students and fees. Set to false for a clean production tenant.
SEED_DEMO_DATA=true

# ── AI (Groq) ────────────────────────────────────────────────────────────────
# Without this, every AI feature returns 503. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Password reset email (Resend) ────────────────────────────────────────────
# Without RESEND_API_KEY, "forgot password" still issues tokens but no email is
# delivered (the link is logged instead, and returned in non-production).
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Nyxion EduOS
RESET_TOKEN_EXPIRE_MINUTES=60

# Used to build the reset link in the email — must match the deployed frontend.
FRONTEND_URL=https://nyxion-eduos.vercel.app

# ── Optional: Supabase REST logging (app_logs table) ─────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SERVICE_NAME=nyxion-eduos
